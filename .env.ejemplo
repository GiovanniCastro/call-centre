# Copia este archivo a `.env` y rellena lo que vayas a usar.
# `.env` está en .gitignore: nunca se versiona, y gitleaks lo vigila en CI.
#
# El sistema arranca sin ninguna de estas variables. Los canales sin credenciales
# quedan declarados y sin configurar, y el arranque imprime qué les falta.

PUERTO=8787

# ── Telegram — canal primario ────────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram y envía /newbot.
# 2. Guarda el token que te devuelve.
TELEGRAM_BOT_TOKEN=

# 3. Genera un secreto:  openssl rand -hex 32
# 4. Regístralo junto a la URL del webhook:
#      curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -d "url=https://tu-dominio/webhook/telegram" \
#        -d "secret_token=<ESTE_SECRETO>"
#    Telegram lo devolverá en la cabecera X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp — conector, se activa cuando existan las credenciales ───────────
# Requiere cuenta de WhatsApp Business con número corporativo verificado, que no
# puede estar en uso en la aplicación normal de WhatsApp. Ver R-020.

# developers.facebook.com → WhatsApp → Configuración de la API
WHATSAPP_ID_NUMERO=

# Token de usuario del sistema con whatsapp_business_messaging y
# whatsapp_business_management. El token temporal de 24 h sirve para probar.
WHATSAPP_TOKEN=

# Tu aplicación → Configuración → Básica → «Clave secreta de la aplicación»
WHATSAPP_SECRETO_APP=

# Cadena que eliges tú (openssl rand -hex 16) y que escribes también en el
# formulario de Meta al dar de alta el webhook.
WHATSAPP_TOKEN_VERIFICACION=
