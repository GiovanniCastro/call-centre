{
  "name": "perimetro",
  "version": "0.0.0",
  "private": true,
  "description": "Agente de atención al cliente con enrutamiento híbrido, instrumentado para auditar costo y salida de datos",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "arrancar": "node --env-file-if-exists=.env src/main.ts",
    "verificar": "npm run check:tipos && npm run check:lint && npm run check:arquitectura && npm run test",
    "check:tipos": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --test --experimental-test-module-mocks \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3"
  }
}
